{
  "name": "getraenkekarte",
  "version": "5.0.3",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=11.4.2"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "ext": "HOST=0.0.0.0 nodemon src/index.js",
    "lint": "eslint src scripts tests public/js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\"",
    "test": "node --test tests/**/*.test.js",
    "build:admin": "node scripts/build-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "description": "Getränkekarte mit Echtzeit-Updates",
  "dependencies": {
    "basic-auth": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
