{
  "name": "getraenkekarte",
  "version": "5.1.3",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.16.0",
    "npm": ">=11.4.2"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "ext": "HOST=0.0.0.0 node --watch src/index.js",
    "lint": "eslint src scripts tests public/js",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.js\" \"public/js/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\"",
    "test": "node --test tests/**/*.test.js"
  },
  "license": "GPL-3.0-only",
  "description": "Getränkekarte mit Echtzeit-Updates",
  "dependencies": {
    "basic-auth": "^3.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
